# Copy to .env and fill in values for local development.
# Never commit .env to version control.

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres?currentSchema=identity_framework
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Azure Entra ID (Microsoft Graph)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# JWT signing secret (HMAC-SHA256, base64 or raw string used by SecurityConfig)
JWT_SECRET=

# AES key for SSN field encryption at rest (32+ characters recommended)
SSN_ENCRYPTION_KEY=

# Optional: activate local profile for debug logging
SPRING_PROFILES_ACTIVE=local
